# Model Provider configuration
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-flash-lite-latest

TEMPERATURE=0.7
MAX_TOKENS=2048

# API Keys (Provide your active key)
GOOGLE_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

# Assistant Persona & User Profile
AGENT_NAME=wolf
DEFAULT_USER_NAME=Alex
MAX_HISTORY_MESSAGES=16
STORAGE_DIR=./data
DATABASE_FILE=./data/conversations.db
USER_FACTS_FILE=./data/user_profile.json

# GitHub MCP Server (Optional for private repos)
GITHUB_USERNAME=
GITHUB_TOKEN=
